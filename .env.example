# Copie para .env.local e preencha. Nada aqui é obrigatório em desenvolvimento:
# sem Turso o app usa file:local.db, e sem Google Client ID aparece o modo local.

# Turso (libsql). Vazio em dev = arquivo local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Login com Google (mesmo OAuth client do Portal Sheep serve, com a origem deste app liberada)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Workspace autorizado (claim hd do Google). Padrão do Portal Sheep.
GOOGLE_ALLOWED_DOMAIN=sheeptechnology.com
# E-mails avulsos fora do domínio, separados por vírgula
ADMIN_GOOGLE_EMAILS=

# Só para testar o build de produção na máquina sem Google (nunca na Vercel)
# PERMITIR_MODO_LOCAL=1

# Assinatura do cookie de sessão (mínimo 32 caracteres). Obrigatório em produção.
SESSION_SECRET=

# Fase 3
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
BLOB_READ_WRITE_TOKEN=
